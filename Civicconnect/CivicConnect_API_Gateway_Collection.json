    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "http://localhost:9999/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9999",
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:9999/api/v1/auth/validate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9999",
              "path": ["api", "v1", "auth", "validate"]
            }
          }
        }
      ]
