{
	"info": {
		"_postman_id": "civicconnect-api-collection",
		"name": "CivicConnect Microservices API",
		"description": "Complete API collection for CivicConnect Microservices Platform.\n\n**Base URL (API Gateway):** http://localhost:9999\n\n**Authentication:** Bearer Token (JWT)\n\n**Roles:**\n- CITIZEN\n- SERVICE_OFFICER\n- DEPARTMENT_HEAD\n- CITY_ADMINISTRATOR\n- COMPLIANCE_OFFICER",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:9999",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "1. Authentication",
			"description": "Login endpoints - No token required",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"citizen@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Authenticate using email + password. Returns a signed JWT (valid 1 hour).\n\n**Roles:** All (CITIZEN, SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR, COMPLIANCE_OFFICER)"
					}
				}
			]
		},
		{
			"name": "2. Citizen Service",
			"description": "Citizen registration, profile, and document management",
			"item": [
				{
					"name": "Register Citizen (Public)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"johndoe@example.com\",\n    \"phone\": \"9876543210\",\n    \"password\": \"SecurePass123\",\n    \"dateOfBirth\": \"1990-05-15\",\n    \"address\": \"123 Main Street, Chennai\",\n    \"contactInfo\": \"johndoe@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "register"]
						},
						"description": "Public endpoint. Creates a User (INACTIVE) and Citizen profile.\n\n**Auth:** None required"
					}
				},
				{
					"name": "Get Citizen by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/:citizenId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", ":citizenId"],
							"variable": [
								{
									"key": "citizenId",
									"value": "1"
								}
							]
						},
						"description": "Get citizen by ID.\n\n**Roles:** CITIZEN, SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Citizen by User ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/by-user/:userId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "by-user", ":userId"],
							"variable": [
								{
									"key": "userId",
									"value": "1"
								}
							]
						},
						"description": "Get citizen by user ID.\n\n**Roles:** CITIZEN, SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get My Profile (CITIZEN)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/my-profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "my-profile"]
						},
						"description": "Returns the logged-in citizen's profile. citizenId is auto-resolved from JWT.\n\n**Roles:** CITIZEN only"
					}
				},
				{
					"name": "Update My Profile (CITIZEN)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9876543211\",\n    \"address\": \"456 New Street, Chennai\",\n    \"contactInfo\": \"updated@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/my-profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "my-profile"]
						},
						"description": "Citizen can update their own address, contactInfo, and phone.\n\n**Roles:** CITIZEN only"
					}
				},
				{
					"name": "Upload My Document (CITIZEN)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "docType",
									"value": "ID_PROOF",
									"type": "text"
								},
								{
									"key": "file",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/my-documents",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "my-documents"]
						},
						"description": "Upload ID_PROOF or RESIDENCE_PROOF. citizenId is auto-resolved from JWT.\n\n**Roles:** CITIZEN only"
					}
				},
				{
					"name": "Get My Documents (CITIZEN)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/my-documents",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "my-documents"]
						},
						"description": "Returns all documents uploaded by the logged-in citizen.\n\n**Roles:** CITIZEN only"
					}
				},
				{
					"name": "Get Documents by Citizen ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/:citizenId/documents",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", ":citizenId", "documents"],
							"variable": [
								{
									"key": "citizenId",
									"value": "1"
								}
							]
						},
						"description": "Get all documents for a citizen.\n\n**Roles:** CITIZEN, SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Pending Documents (Officers)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/documents/pending",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "documents", "pending"]
						},
						"description": "Get all PENDING documents for verification.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Verify Document (Officers)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"newStatus\": \"VERIFIED\",\n    \"remarks\": \"Document verified successfully\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/documents/:documentId/verify",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", "documents", ":documentId", "verify"],
							"variable": [
								{
									"key": "documentId",
									"value": "1"
								}
							]
						},
						"description": "Verify or reject document. Set status to VERIFIED or REJECTED.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Deactivate Citizen (ADMIN)",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/citizens/:citizenId/deactivate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "citizens", ":citizenId", "deactivate"],
							"variable": [
								{
									"key": "citizenId",
									"value": "1"
								}
							]
						},
						"description": "Deactivate citizen account.\n\n**Roles:** CITY_ADMINISTRATOR only"
					}
				}
			]
		},
		{
			"name": "3. Service Request",
			"description": "Submit, track, and manage service requests",
			"item": [
				{
					"name": "Submit Service Request (CITIZEN)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"ROAD\",\n    \"description\": \"Large pothole on main road causing traffic issues\",\n    \"location\": \"MG Road, Chennai\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests"]
						},
						"description": "Submit a new service request. citizenId is auto-resolved from JWT.\n\n**Type:** ROAD, WATER, ELECTRICITY, SANITATION, OTHER\n\n**Roles:** CITIZEN only (must have ACTIVE account)"
					}
				},
				{
					"name": "Get My Requests (CITIZEN)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/my-requests",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", "my-requests"]
						},
						"description": "Get all service requests submitted by the logged-in citizen.\n\n**Roles:** CITIZEN only"
					}
				},
				{
					"name": "Get Request by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/:requestId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", ":requestId"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Get service request by ID.\n\n**Roles:** CITIZEN, SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Requests by Citizen ID (Officers)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/citizen/:citizenId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", "citizen", ":citizenId"],
							"variable": [
								{
									"key": "citizenId",
									"value": "1"
								}
							]
						},
						"description": "Get all requests by a citizen ID.\n\n**Roles:** DEPARTMENT_HEAD, CITY_ADMINISTRATOR, COMPLIANCE_OFFICER"
					}
				},
				{
					"name": "Get Request Updates",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/:requestId/updates",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", ":requestId", "updates"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Get update history for a request.\n\n**Roles:** CITIZEN, SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Requests by Officer ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/officer/:officerId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", "officer", ":officerId"],
							"variable": [
								{
									"key": "officerId",
									"value": "1"
								}
							]
						},
						"description": "Get requests assigned to an officer.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Requests by Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests?status=SUBMITTED",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests"],
							"query": [
								{
									"key": "status",
									"value": "SUBMITTED",
									"description": "SUBMITTED | ASSIGNED | IN_PROGRESS | RESOLVED | CLOSED"
								}
							]
						},
						"description": "Get requests filtered by status. SERVICE_OFFICER sees only their assigned requests.\n\n**Status:** SUBMITTED, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Assign Officer to Request",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"officerId\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/:requestId/assign",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", ":requestId", "assign"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Assign a SERVICE_OFFICER to a SUBMITTED request.\n\n**Roles:** DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Update Request Status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"newStatus\": \"IN_PROGRESS\",\n    \"comments\": \"Started working on the issue\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/:requestId/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", ":requestId", "status"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Update request status. Forward-only: ASSIGNED → IN_PROGRESS → RESOLVED.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR (assigned officer only)"
					}
				},
				{
					"name": "Close Request (CITIZEN)",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/:requestId/close",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", ":requestId", "close"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Citizen confirms resolution. Request must be in RESOLVED status.\n\n**Roles:** CITIZEN only"
					}
				},
				{
					"name": "Withdraw Request (CITIZEN)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/service-requests/:requestId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "service-requests", ":requestId"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Withdraw a SUBMITTED (unassigned) request.\n\n**Roles:** CITIZEN only"
					}
				}
			]
		},
		{
			"name": "4. Resolution Service",
			"description": "Issue resolution and workflow step management",
			"item": [
				{
					"name": "Create Resolution",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"serviceRequestId\": 1,\n    \"description\": \"Resolution plan for the reported issue\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions"]
						},
						"description": "Create resolution for an ASSIGNED service request. Auto-pushes IN_PROGRESS status.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Resolution by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions/:resolutionId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions", ":resolutionId"],
							"variable": [
								{
									"key": "resolutionId",
									"value": "1"
								}
							]
						},
						"description": "Get resolution by ID.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Resolution by Request ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions/by-request/:requestId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions", "by-request", ":requestId"],
							"variable": [
								{
									"key": "requestId",
									"value": "1"
								}
							]
						},
						"description": "Get resolution by service request ID.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Resolutions by Officer ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions/officer/:officerId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions", "officer", ":officerId"],
							"variable": [
								{
									"key": "officerId",
									"value": "1"
								}
							]
						},
						"description": "Get all resolutions by officer.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Add Workflow Step",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"description\": \"Inspect the site\",\n    \"assignedToUserId\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions/:resolutionId/steps",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions", ":resolutionId", "steps"],
							"variable": [
								{
									"key": "resolutionId",
									"value": "1"
								}
							]
						},
						"description": "Add a workflow step to an IN_PROGRESS resolution.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Get Workflow Steps",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions/:resolutionId/steps",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions", ":resolutionId", "steps"],
							"variable": [
								{
									"key": "resolutionId",
									"value": "1"
								}
							]
						},
						"description": "Get all workflow steps for a resolution.\n\n**Roles:** SERVICE_OFFICER, DEPARTMENT_HEAD, CITY_ADMINISTRATOR"
					}
				},
				{
					"name": "Update Workflow Step Status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"newStatus\": \"IN_PROGRESS\",\n    \"notes\": \"Started inspection\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/resolutions/steps/:stepId/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resolutions", "steps", ":stepId", "status"],
							"variable": [
								{
									"key": "stepId",
									"value": "1"
								}
